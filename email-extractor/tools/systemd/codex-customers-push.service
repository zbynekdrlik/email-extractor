[Unit]
Description=Push the CODEX customer cards to the email-extractor add-on (#493)
Documentation=https://github.com/zbynekdrlik/email-extractor/issues/493
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=newlevel
Group=newlevel
# The SAME EnvironmentFile as the other CODEX pushes (mode-600, never committed): CODEX_PUSH_URL /
# CODEX_PUSH_TOKEN / CODEX_DUCKDB_PATH. The customers URL is derived from CODEX_PUSH_URL
# (.../api/codex/orders -> .../api/codex/customers) unless CODEX_CUSTOMERS_PUSH_URL is set.
EnvironmentFile=/home/newlevel/.secrets/codex-orders-push.env
ExecStart=/usr/bin/python3 /home/newlevel/codex-orders-push/codex_customers_push.py
# Read-only DuckDB + one HTTP POST of the whole list. No timer of its own: the guarded round
# codex-push-after-etl.service runs this tool after each ETL; this unit is for a manual one-off
# push (the add-on keeps the last copy — fail-open — and alerts ops after 30 h without one).
TimeoutStartSec=300
Nice=10
