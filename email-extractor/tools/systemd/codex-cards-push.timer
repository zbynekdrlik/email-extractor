[Unit]
Description=Timer: push the CODEX stock-card list after each codex-bridge ETL run (#467)
Documentation=https://github.com/zbynekdrlik/email-extractor/issues/467

[Timer]
# codex-bridge ETL loads sm002 at 14:15 and 18:00 Europe/Prague; the orders push (#342) runs at
# 14:40 / 18:25 — this one 2 min later so the two read-only DuckDB readers never start together.
# TZ suffix + Persistent mirror codex-orders-push.timer / codex-bridge-etl.timer (systemd 255).
OnCalendar=*-*-* 14:42:00 Europe/Prague
OnCalendar=*-*-* 18:27:00 Europe/Prague
Persistent=true

[Install]
WantedBy=timers.target
